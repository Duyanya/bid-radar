[Unit]
Description=Bid Radar daily crawl (CMCC / CT / CU)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bidradar
Group=bidradar
WorkingDirectory=/opt/bid-radar
Environment=PYTHONIOENCODING=utf-8
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/bid-radar/.cache/ms-playwright
ExecStart=/opt/bid-radar/.venv/bin/python /opt/bid-radar/collector.py all 15 20
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
